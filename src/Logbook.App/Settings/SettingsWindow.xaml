<Window x:Class="Logbook.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource WindowIcon}"
        Title="Logbook settings" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <DockPanel>
        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSaveClick" />
          <Button Content="Cancel" Style="{StaticResource FooterButton}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Margin="{StaticResource PagePadding}">
      <TextBlock Style="{StaticResource TitleText}" Text="Settings" />

      <TextBlock Style="{StaticResource SectionText}" Text="Hotkeys" Margin="0,20,0,0" />
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Label Content="New entry" />
          <TextBox x:Name="CaptureHotkey" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Label Content="Main window" />
          <TextBox x:Name="MainWindowHotkey" />
        </StackPanel>
      </Grid>
      <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Text="Modifiers plus a key, for example Ctrl+Alt+L or Ctrl+Shift+F12." />

      <TextBlock Style="{StaticResource SectionText}" Text="Autocomplete" Margin="0,20,0,0" />
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Label Content="Suggestions shown" />
          <TextBox x:Name="AutocompleteCap" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Label Content="Ranked by" />
          <ComboBox x:Name="AutocompleteRanking" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="most recently used" Tag="recent" />
            <ComboBoxItem Content="most frequently used" Tag="frequent" />
          </ComboBox>
        </StackPanel>
      </Grid>

      <TextBlock Style="{StaticResource SectionText}" Text="Lock" Margin="0,20,0,0" />
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Label Content="Lock after (minutes)" />
          <TextBox x:Name="IdleLockMinutes" />
        </StackPanel>
      </Grid>
      <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="Lock after N minutes without any input to Windows; 0 never locks. Working in other apps keeps Logbook unlocked." />

      <TextBlock Style="{StaticResource SectionText}" Text="Appearance" Margin="0,20,0,0" />
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Label Content="Theme" />
          <ComboBox x:Name="ThemeChoice" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Follow Windows" Tag="system" />
            <ComboBoxItem Content="Light" Tag="light" />
            <ComboBoxItem Content="Dark" Tag="dark" />
          </ComboBox>
        </StackPanel>
      </Grid>

      <TextBlock Style="{StaticResource SectionText}" Text="Startup" Margin="0,20,0,0" />
      <CheckBox x:Name="StartWithWindows" Margin="0,6,0,0" Content="Start Logbook when I sign in (a shortcut in the Startup folder)" />

      <TextBlock Style="{StaticResource SectionText}" Text="Files" Margin="0,20,0,0" />
      <Label Content="Data file" Margin="0,6,0,0" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="DataFilePath" IsReadOnly="True" />
        <Button x:Name="ChooseAnother" Grid.Column="1" Content="Choose another…" Margin="8,0,0,0" Click="OnChooseAnotherClick" />
      </Grid>
      <TextBlock x:Name="FileInfo" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />

      <TextBlock x:Name="Problem" Style="{StaticResource ProblemText}" Margin="0,12,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
