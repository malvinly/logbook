<Window x:Class="Logbook.App.Capture.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New entry" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
          CornerRadius="{StaticResource MediumRadius}" Margin="8" Padding="{StaticResource PagePadding}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
    </Border.Effect>
    <StackPanel>
      <Grid>
        <TextBox x:Name="Line" FontSize="{StaticResource CaptureSize}" TextChanged="OnLineChanged" />
        <TextBlock x:Name="Placeholder" Text="What happened?  #tag  @person  at:yesterday,3pm" IsHitTestVisible="False"
                   FontSize="{StaticResource CaptureSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
      </Grid>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl x:Name="Chips" ItemsPanel="{StaticResource ChipPanel}" VerticalAlignment="Center" MinHeight="22" />
        <Button x:Name="MoreButton" Grid.Column="1" Style="{StaticResource LinkButton}" Content="More  ˅" Click="OnMoreClick" ToolTip="Ctrl+Enter" />
      </Grid>
      <TextBlock x:Name="Problem" Style="{StaticResource CaptionText}" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
      <StackPanel x:Name="More" Visibility="Collapsed" Margin="0,12,0,0">
        <Label Content="Reason" />
        <TextBox x:Name="Reason" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="Additional tags" />
            <TextBox x:Name="ExtraTags" ToolTip="Separate with spaces" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Additional people" />
            <TextBox x:Name="ExtraPeople" ToolTip="Separate with spaces" />
          </StackPanel>
        </Grid>
        <Label Content="Refs (one per line: ticket numbers, links, paths)" Margin="0,8,0,0" />
        <TextBox x:Name="Refs" AcceptsReturn="True" MinHeight="44" MaxHeight="100" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button Content="Cancel" Click="OnCancelClick" Margin="0,0,8,0" />
          <Button Content="Log it" Style="{StaticResource AccentButton}" Click="OnLogClick" />
        </StackPanel>
      </StackPanel>
      <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text="Enter logs it · Esc cancels · Ctrl+Enter for reason, refs and more" />
    </StackPanel>
  </Border>
</Window>
