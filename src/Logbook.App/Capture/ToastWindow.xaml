<Window x:Class="Logbook.App.Capture.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource WindowIcon}"
        Title="Logbook notification" Width="388" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        Cursor="Hand" MouseLeftButtonUp="OnClick" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
  <!-- Laid out as a Windows 11 notification: the app's badge and name, then a status glyph, a title and a line of detail.
       The window stays per-pixel transparent (no acrylic) so the whole toast can fade out (DESIGN.md section 16). -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border Style="{StaticResource ToastSurface}">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Border Width="16" Height="16" CornerRadius="{StaticResource SmallRadius}" Background="{DynamicResource AccentBrush}">
          <!-- The same "L" as the tray icon. -->
          <Path Data="M5.5,3.5 L5.5,12 L11.5,12" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Border>
        <TextBlock Text="Logbook" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusGlyph" Style="{StaticResource IconText}" FontSize="{StaticResource TitleSize}" Text="&#xE930;"
                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="Headline" Style="{StaticResource SectionText}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Detail" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</Window>
