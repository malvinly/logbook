<Window x:Class="Logbook.App.Dialogs.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource WindowIcon}"
        Title="Logbook" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
  <!-- The app's own message box, laid out as a Windows 11 content dialog: a glyph, a heading, the message, and the
       buttons in a footer band. The default button is the accent one. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PrimaryButton" Click="OnPrimaryClick" />
        <Button x:Name="SecondaryButton" IsCancel="True" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
    <Grid Margin="{StaticResource PagePadding}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" FontSize="{StaticResource DialogIconSize}" VerticalAlignment="Top" Margin="0,2,16,0" />
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
