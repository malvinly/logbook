<Application x:Class="Logbook.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- WPF's built-in Fluent theme styles every stock control; merging its dictionary is the documented way to apply it
           without the Application.ThemeMode API, which .NET 10 still marks experimental (WPF0001). Fluent.xaml follows the
           Windows light or dark setting by itself; AppTheme swaps the second entry, Logbook's tokens, to match. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Logbook;component/Theme/Theme.Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Logbook;component/Theme/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
