<Application x:Class="Logbook.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!-- WPF's built-in Fluent theme styles every stock control; merging its dictionary is the documented way to apply it
           without the Application.ThemeMode API, which .NET 10 still marks experimental (WPF0001). AppTheme replaces the
           first two entries with their dark twins when Windows is in dark mode; the order matters (see AppTheme). -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Logbook;component/Theme/Theme.Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Logbook;component/Theme/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
