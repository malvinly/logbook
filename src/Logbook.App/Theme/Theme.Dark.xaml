<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark color tokens. Theme.Light.xaml has the same keys; AppTheme swaps one for the other to follow Windows.
       The values follow the Windows 11 palette that WPF's Fluent theme uses, so Logbook's own surfaces sit beside the
       stock controls without a seam. Views refer to the brushes with DynamicResource so a live switch repaints them. -->

  <!-- Opaque window surface for when there is no Mica or acrylic behind it (Windows 10, or a failed DWM call). -->
  <Color x:Key="WindowBackgroundColor">#FF202020</Color>
  <!-- Translucent layers that sit on Mica: a card (list, detail pane) and the dialog footer band. -->
  <Color x:Key="CardColor">#0DFFFFFF</Color>
  <Color x:Key="CardStrokeColor">#19000000</Color>
  <Color x:Key="LayerColor">#4C3A3A3A</Color>
  <!-- Opaque surfaces for popups and the toast, which have no backdrop of their own. -->
  <Color x:Key="FlyoutColor">#FF2C2C2C</Color>
  <Color x:Key="FlyoutStrokeColor">#66757575</Color>
  <Color x:Key="DividerColor">#15FFFFFF</Color>
  <Color x:Key="TextColor">#FFFFFFFF</Color>
  <Color x:Key="TextMutedColor">#C5FFFFFF</Color>
  <Color x:Key="HoverColor">#0FFFFFFF</Color>
  <Color x:Key="SelectionColor">#15FFFFFF</Color>
  <Color x:Key="DangerColor">#FFFF99A4</Color>
  <Color x:Key="CautionColor">#FFFCE100</Color>
  <Color x:Key="TagChipColor">#FF1F3550</Color>
  <Color x:Key="TagChipTextColor">#FF9CC8FF</Color>
  <Color x:Key="PersonChipColor">#FF4A3518</Color>
  <Color x:Key="PersonChipTextColor">#FFFFC98A</Color>
  <Color x:Key="DateChipColor">#FF1E3B28</Color>
  <Color x:Key="DateChipTextColor">#FF8FD9A8</Color>
  <Color x:Key="ChangedColor">#FF4D4219</Color>
  <!-- The tray icon is drawn once from these and sits on the taskbar, so they are opaque. -->
  <Color x:Key="TrayLockedColor">#FF8A8A94</Color>
  <Color x:Key="TrayPendingColor">#FFC42B1C</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
  <SolidColorBrush x:Key="LayerBrush" Color="{StaticResource LayerColor}" />
  <SolidColorBrush x:Key="FlyoutBrush" Color="{StaticResource FlyoutColor}" />
  <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="{StaticResource FlyoutStrokeColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}" />
  <SolidColorBrush x:Key="TagChipBrush" Color="{StaticResource TagChipColor}" />
  <SolidColorBrush x:Key="TagChipTextBrush" Color="{StaticResource TagChipTextColor}" />
  <SolidColorBrush x:Key="PersonChipBrush" Color="{StaticResource PersonChipColor}" />
  <SolidColorBrush x:Key="PersonChipTextBrush" Color="{StaticResource PersonChipTextColor}" />
  <SolidColorBrush x:Key="DateChipBrush" Color="{StaticResource DateChipColor}" />
  <SolidColorBrush x:Key="DateChipTextBrush" Color="{StaticResource DateChipTextColor}" />
  <SolidColorBrush x:Key="ChangedBrush" Color="{StaticResource ChangedColor}" />
  <SolidColorBrush x:Key="TrayLockedBrush" Color="{StaticResource TrayLockedColor}" />
  <SolidColorBrush x:Key="TrayPendingBrush" Color="{StaticResource TrayPendingColor}" />

  <!-- The accent comes from Windows. On a dark surface the lighter shade keeps text and the selection pill legible. -->
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}" />

</ResourceDictionary>
