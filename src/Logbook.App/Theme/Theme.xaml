<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:chips="clr-namespace:Logbook.App.Chips">

  <!-- The one place colors, fonts, sizes and radii live (DESIGN.md section 16). A dark theme is a second copy of this file. -->

  <Color x:Key="BackgroundColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceColor">#FFF4F4F6</Color>
  <Color x:Key="BorderColor">#FFD6D6DC</Color>
  <Color x:Key="TextColor">#FF1E1E24</Color>
  <Color x:Key="TextMutedColor">#FF6E6E78</Color>
  <Color x:Key="AccentColor">#FF2F6FED</Color>
  <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
  <Color x:Key="SelectionColor">#FFE4ECFD</Color>
  <Color x:Key="DangerColor">#FFC43C3C</Color>
  <Color x:Key="DangerTextColor">#FFFFFFFF</Color>
  <Color x:Key="TagChipColor">#FFE4ECFD</Color>
  <Color x:Key="TagChipTextColor">#FF2250B8</Color>
  <Color x:Key="PersonChipColor">#FFFCEBD2</Color>
  <Color x:Key="PersonChipTextColor">#FF8A4B08</Color>
  <Color x:Key="DateChipColor">#FFE2F3E8</Color>
  <Color x:Key="DateChipTextColor">#FF1F6B3A</Color>
  <Color x:Key="ChangedColor">#FFFFF4CC</Color>
  <Color x:Key="ToastColor">#FF2B2B33</Color>
  <Color x:Key="ToastTextColor">#FFFFFFFF</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
  <SolidColorBrush x:Key="TagChipBrush" Color="{StaticResource TagChipColor}" />
  <SolidColorBrush x:Key="TagChipTextBrush" Color="{StaticResource TagChipTextColor}" />
  <SolidColorBrush x:Key="PersonChipBrush" Color="{StaticResource PersonChipColor}" />
  <SolidColorBrush x:Key="PersonChipTextBrush" Color="{StaticResource PersonChipTextColor}" />
  <SolidColorBrush x:Key="DateChipBrush" Color="{StaticResource DateChipColor}" />
  <SolidColorBrush x:Key="DateChipTextBrush" Color="{StaticResource DateChipTextColor}" />
  <SolidColorBrush x:Key="ChangedBrush" Color="{StaticResource ChangedColor}" />
  <SolidColorBrush x:Key="ToastBrush" Color="{StaticResource ToastColor}" />
  <SolidColorBrush x:Key="ToastTextBrush" Color="{StaticResource ToastTextColor}" />

  <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>
  <sys:Double x:Key="CaptionSize">11.5</sys:Double>
  <sys:Double x:Key="BodySize">13</sys:Double>
  <sys:Double x:Key="TitleSize">16</sys:Double>
  <sys:Double x:Key="DisplaySize">20</sys:Double>
  <sys:Double x:Key="CaptureSize">18</sys:Double>

  <CornerRadius x:Key="SmallRadius">4</CornerRadius>
  <CornerRadius x:Key="MediumRadius">8</CornerRadius>
  <CornerRadius x:Key="ChipRadius">10</CornerRadius>
  <Thickness x:Key="PagePadding">16</Thickness>
  <Thickness x:Key="ControlPadding">8,5</Thickness>
  <Thickness x:Key="ChipPadding">8,2</Thickness>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource TitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource DisplaySize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource SmallRadius}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource SmallRadius}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter Margin="{TemplateBinding Padding}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
    <Setter Property="Padding" Value="0,0,0,2" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource SmallRadius}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource ChipRadius}" />
    <Setter Property="Padding" Value="{StaticResource ChipPadding}" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TagChip" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{StaticResource TagChipBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource TagChipTextBrush}" />
  </Style>

  <Style x:Key="PersonChip" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{StaticResource PersonChipBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource PersonChipTextBrush}" />
  </Style>

  <Style x:Key="DateChip" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{StaticResource DateChipBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource DateChipTextBrush}" />
  </Style>

  <!-- The text inherits TextElement.Foreground from the chip border, so no Foreground setter here. -->
  <Style x:Key="ChipText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <DataTemplate DataType="{x:Type chips:Chip}">
    <Border x:Name="ChipBorder" Style="{StaticResource TagChip}">
      <TextBlock Style="{StaticResource ChipText}" Text="{Binding Text}" />
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="Person">
        <Setter TargetName="ChipBorder" Property="Style" Value="{StaticResource PersonChip}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Date">
        <Setter TargetName="ChipBorder" Property="Style" Value="{StaticResource DateChip}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <ItemsPanelTemplate x:Key="ChipPanel">
    <WrapPanel Orientation="Horizontal" />
  </ItemsPanelTemplate>

</ResourceDictionary>
