<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:chips="clr-namespace:Logbook.App.Chips">

  <!-- The one place fonts, sizes, radii, paddings and Logbook's own styles live (DESIGN.md section 16). Colors are in
       Theme.Light.xaml and Theme.Dark.xaml, swapped by AppTheme, so every brush here is a DynamicResource.
       Stock controls (text boxes, buttons, check boxes, combo boxes, date pickers, menus, scroll bars) are styled by WPF's
       Fluent theme, merged before this file in App.xaml; the styles below only add to it and are based on its styles. -->

  <!-- Segoe UI Variable ships with Windows 11; WPF falls back to the next family in the list on Windows 10. -->
  <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <sys:Double x:Key="CaptionSize">12</sys:Double>
  <sys:Double x:Key="BodySize">14</sys:Double>
  <sys:Double x:Key="TitleSize">20</sys:Double>
  <sys:Double x:Key="DisplaySize">28</sys:Double>
  <sys:Double x:Key="CaptureSize">20</sys:Double>
  <sys:Double x:Key="IconSize">16</sys:Double>
  <sys:Double x:Key="DialogIconSize">28</sys:Double>
  <sys:Double x:Key="FooterButtonWidth">96</sys:Double>

  <CornerRadius x:Key="SmallRadius">4</CornerRadius>
  <CornerRadius x:Key="MediumRadius">8</CornerRadius>
  <CornerRadius x:Key="ChipRadius">10</CornerRadius>
  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="FooterPadding">24,16</Thickness>
  <Thickness x:Key="ChipPadding">8,2</Thickness>

  <!-- WPF's Fluent theme applies its Window style to every window, derived types included; this one adds the fonts. -->
  <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <!-- A context menu has no window above it to inherit fonts from (the tray menu, a text box's menu). -->
  <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
  </Style>

  <!-- A group heading inside a page or pane, as in Windows Settings: body size, semibold. -->
  <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="{StaticResource TitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="{StaticResource DisplaySize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="ProblemText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="IconText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="{StaticResource IconSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Field captions above inputs. -->
  <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
  </Style>

  <!-- Buttons in a dialog footer share a minimum width, as in a Windows 11 content dialog. -->
  <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinWidth" Value="{StaticResource FooterButtonWidth}" />
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinWidth" Value="{StaticResource FooterButtonWidth}" />
  </Style>

  <!-- Destructive actions keep the standard button and say so in the text color, as Windows Settings does. -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- A text-only button (the capture box's "More"); Fluent has no hyperlink button for WPF. -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A list row in the manner of Windows 11 lists: a subtle fill on hover and selection, and an accent pill on the
       selected row. Fluent's own ListBoxItem fills the whole row with the accent, which is too loud for a log. -->
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The capture box's one large input: bare text on the acrylic, as in a launcher. Fluent's text box draws its own
       field and underline, which is right everywhere else and wrong here, so this one keyed style has its own template. -->
  <Style x:Key="LauncherInput" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource CaptureSize}" />
    <Setter Property="ContextMenu" Value="{DynamicResource DefaultControlContextMenu}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The hint bar at the foot of the capture box. -->
  <Style x:Key="LauncherFooter" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,8" />
  </Style>

  <!-- The toast's surface: opaque, since the toast window is per-pixel transparent so that it can fade, with a margin
       inside the window for the shadow. -->
  <Style x:Key="ToastSurface" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource FlyoutBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FlyoutStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MediumRadius}" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="Padding" Value="16,12,16,16" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.26" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A translucent card on the Mica surface: the results list, the detail pane, a revision. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MediumRadius}" />
  </Style>

  <!-- The band under a dialog's content that holds its buttons, as in a Windows 11 content dialog. -->
  <Style x:Key="DialogFooter" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="{StaticResource FooterPadding}" />
  </Style>

  <!-- An opaque floating surface: the autocomplete list. It has no window above it, so it sets its own fonts. -->
  <Style x:Key="Flyout" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource FlyoutBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FlyoutStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource MediumRadius}" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Margin" Value="0,4,12,12" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextElement.FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource BodySize}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.22" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource ChipRadius}" />
    <Setter Property="Padding" Value="{StaticResource ChipPadding}" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TagChip" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource TagChipBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TagChipTextBrush}" />
  </Style>

  <Style x:Key="PersonChip" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource PersonChipBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PersonChipTextBrush}" />
  </Style>

  <Style x:Key="DateChip" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource DateChipBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource DateChipTextBrush}" />
  </Style>

  <!-- The text inherits TextElement.Foreground from the chip border, so no Foreground setter here. -->
  <Style x:Key="ChipText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <DataTemplate DataType="{x:Type chips:Chip}">
    <Border x:Name="ChipBorder" Style="{StaticResource TagChip}">
      <TextBlock Style="{StaticResource ChipText}" Text="{Binding Text}" />
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="Person">
        <Setter TargetName="ChipBorder" Property="Style" Value="{StaticResource PersonChip}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Date">
        <Setter TargetName="ChipBorder" Property="Style" Value="{StaticResource DateChip}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <ItemsPanelTemplate x:Key="ChipPanel">
    <WrapPanel Orientation="Horizontal" />
  </ItemsPanelTemplate>

</ResourceDictionary>
