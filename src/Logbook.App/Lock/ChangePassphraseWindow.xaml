<Window x:Class="Logbook.App.Lock.ChangePassphraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change passphrase" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=Current}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ChangeButton" Content="Change" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnChangeClick" />
        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource FooterButton}" IsCancel="True" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Margin="{StaticResource PagePadding}">
      <TextBlock Style="{StaticResource TitleText}" Text="Change passphrase" />
      <TextBlock x:Name="FileLabel" Style="{StaticResource CaptionText}" Margin="0,4,0,16" TextTrimming="CharacterEllipsis" />
      <Label Content="Current passphrase" />
      <PasswordBox x:Name="Current" />
      <Label Content="New passphrase" Margin="0,12,0,0" />
      <PasswordBox x:Name="First" />
      <Label Content="New passphrase again" Margin="0,12,0,0" />
      <PasswordBox x:Name="Second" />
      <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="0,20,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{DynamicResource CautionBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
          <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource SectionText}" Text="There is still no recovery." />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="After the change only the new passphrase opens the log; the old one stops working. If you lose the new one, the log is lost. Nobody can reset it, including you. Write it down somewhere physical before you press Change." />
            <CheckBox x:Name="Understood" Margin="0,12,0,0" Content="I have written the new passphrase down and I understand there is no recovery." />
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock x:Name="Problem" Style="{StaticResource ProblemText}" Margin="0,12,0,0" MinHeight="18" />
    </StackPanel>
  </DockPanel>
</Window>
