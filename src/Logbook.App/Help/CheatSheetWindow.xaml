<Window x:Class="Logbook.App.Help.CheatSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logbook cheat sheet" Width="780" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <Button Content="Close" Style="{StaticResource AccentButton}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" />
    </Border>
    <StackPanel Margin="{StaticResource PagePadding}">
      <TextBlock Style="{StaticResource TitleText}" Text="Cheat sheet" />

      <TextBlock Style="{StaticResource SectionText}" Text="Hotkeys" Margin="0,20,0,0" />
      <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="0,8,0,0">
        <TextBlock x:Name="Hotkeys" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource CaptionSize}" />
      </Border>

      <TextBlock Style="{StaticResource SectionText}" Text="One grammar, for capture and for the filter bar" Margin="0,20,0,0" />
      <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="0,8,0,0">
        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource CaptionSize}" xml:space="preserve">#tag            lowercase-kebab; several are ANDed in a filter
@person         anyone involved, any role; the verb goes in a tag (#asked, #told, #decided)
at:...          capture only: at:2026-10-06  at:2026-10-06,15:00  at:yesterday,3pm  at:15:00  at:mon
since: until:   filter only, inclusive dates: 2026-10-06, today, yesterday
last:30d        filter only: d, w or m, shorthand for since:
"exact phrase"  filter only: substring match on the phrase
anything else   capture: the summary · filter: words ANDed over summary and reason
\#word \@word   a literal # or @ in a summary</TextBlock>
      </Border>

      <TextBlock Style="{StaticResource SectionText}" Text="Saved queries" Margin="0,20,0,0" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="Type a filter in the main window and click Save filter as button; right-click a button to remove it. A weekly digest is a saved last:7d: one click, then Copy as timeline." />

      <TextBlock Style="{StaticResource SectionText}" Text="Things that stay plain text" Margin="0,20,0,0" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="ticket #12345, C#, name@example.com and @ 3pm are not tokens: # and @ only count after a space, an opening ( or &quot;, or the , or ; ending another token, and before a letter, so @j-doe,@a-smith is two people. Trailing , . ; : ) &quot; ? ! and 's are dropped from a token or keyword value and stay in the text; a lone leftover like the () of (#asked) goes. A backslash is dropped only where it stops a token: \#word is literal, \\server\#share stays as typed. A date without a time is stored at noon; use the compact export when the time is not meaningful." />

      <TextBlock Style="{StaticResource SectionText}" Text="Conventions worth keeping" Margin="0,20,0,0" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="Keep tags coarse: a tag you will use once is a word in the summary. Your own notes are discoverable in a dispute, and that cuts both ways; write entries you would be comfortable reading aloud." />
    </StackPanel>
  </DockPanel>
</Window>
