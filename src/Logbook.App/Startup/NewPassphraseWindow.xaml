<Window x:Class="Logbook.App.Startup.NewPassphraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource WindowIcon}"
        Title="Choose a passphrase" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FocusManager.FocusedElement="{Binding ElementName=First}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Create the log" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnCreateClick" />
        <Button Content="Back" Style="{StaticResource FooterButton}" IsCancel="True" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Margin="{StaticResource PagePadding}">
      <TextBlock Style="{StaticResource TitleText}" Text="Choose a passphrase" />
      <TextBlock x:Name="FileLabel" Style="{StaticResource CaptionText}" Margin="0,4,0,16" TextTrimming="CharacterEllipsis" />
      <Label Content="Passphrase" />
      <PasswordBox x:Name="First" />
      <Label Content="Again" Margin="0,12,0,0" />
      <PasswordBox x:Name="Second" />
      <Border Style="{StaticResource Card}" Padding="{StaticResource CardPadding}" Margin="0,20,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{DynamicResource CautionBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
          <StackPanel Grid.Column="1">
            <TextBlock Style="{StaticResource SectionText}" Text="There is no recovery." />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="If you lose this passphrase, the log is lost. Nobody can reset it, including you. Write it down somewhere physical: this machine and its password manager may not be yours forever." />
            <CheckBox x:Name="Understood" Margin="0,12,0,0" Content="I have written it down and I understand there is no recovery." />
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock x:Name="Problem" Style="{StaticResource ProblemText}" Margin="0,12,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
