<Window x:Class="Logbook.App.Startup.NewPassphraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a passphrase" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FocusManager.FocusedElement="{Binding ElementName=First}">
  <StackPanel Margin="{StaticResource PagePadding}">
    <TextBlock Style="{StaticResource TitleText}" Text="Choose a passphrase" />
    <TextBlock x:Name="FileLabel" Style="{StaticResource CaptionText}" Margin="0,4,0,12" TextTrimming="CharacterEllipsis" />
    <Label Content="Passphrase" />
    <PasswordBox x:Name="First" />
    <Label Content="Again" Margin="0,8,0,0" />
    <PasswordBox x:Name="Second" />
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource SmallRadius}" Padding="12" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="There is no recovery." />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="If you lose this passphrase, the log is lost. Nobody can reset it, including you. Write it down somewhere physical: this machine and its password manager may not be yours forever." />
        <CheckBox x:Name="Understood" Margin="0,8,0,0" Content="I have written it down and I understand there is no recovery." />
      </StackPanel>
    </Border>
    <TextBlock x:Name="Problem" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Back" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Create the log" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnCreateClick" />
    </StackPanel>
  </StackPanel>
</Window>
