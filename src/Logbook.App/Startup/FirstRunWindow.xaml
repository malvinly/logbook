<Window x:Class="Logbook.App.Startup.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Logbook" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
  <StackPanel Margin="{StaticResource PagePadding}">
    <TextBlock Style="{StaticResource DisplayText}" Text="Welcome to Logbook" />
    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
               Text="Logbook keeps one encrypted, append-only file in your synced folder. Choose where it lives." />

    <Label Content="Synced folder (from an environment variable)" Margin="0,16,0,0" />
    <ComboBox x:Name="RootVar" SelectionChanged="OnRootChanged" />
    <TextBlock x:Name="RootPath" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

    <Label Content="Data file" Margin="0,12,0,0" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FilePath" TextChanged="OnFileChanged" />
      <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseClick" />
    </Grid>
    <TextBlock x:Name="FileNote" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />

    <TextBlock x:Name="Problem" Foreground="{DynamicResource DangerBrush}" Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Quit" IsCancel="True" Margin="0,0,8,0" />
      <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnContinueClick" />
    </StackPanel>
  </StackPanel>
</Window>
