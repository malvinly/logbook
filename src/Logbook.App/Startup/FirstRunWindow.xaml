<Window x:Class="Logbook.App.Startup.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource WindowIcon}"
        Title="Welcome to Logbook" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnContinueClick" />
        <Button Content="Quit" Style="{StaticResource FooterButton}" IsCancel="True" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Margin="{StaticResource PagePadding}">
      <TextBlock Style="{StaticResource DisplayText}" Text="Welcome to Logbook" />
      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                 Text="Logbook keeps one encrypted, append-only file in your synced folder. Choose where it lives." />

      <Label Content="Synced folder (from an environment variable)" Margin="0,20,0,0" />
      <ComboBox x:Name="RootVar" HorizontalAlignment="Stretch" SelectionChanged="OnRootChanged" />
      <TextBlock x:Name="RootPath" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

      <Label Content="Data file" Margin="0,16,0,0" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilePath" TextChanged="OnFileChanged" />
        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseClick" />
      </Grid>
      <TextBlock x:Name="FileNote" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />

      <TextBlock x:Name="Problem" Style="{StaticResource ProblemText}" Margin="0,12,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
