<Window x:Class="Logbook.App.Startup.PickFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:startup="clr-namespace:Logbook.App.Startup"
        Title="Which log is the real one?" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
  <StackPanel Margin="{StaticResource PagePadding}">
    <TextBlock Style="{StaticResource TitleText}" Text="More than one log file was found" />
    <TextBlock Margin="0,6,0,12" TextWrapping="Wrap"
               Text="Sync conflict copies and old-profile re-syncs leave extra logbook*.jsonl files beside each other. Logbook will not guess. Pick the one to open; the others are left untouched." />
    <ListBox x:Name="Files" MaxHeight="320" MouseDoubleClick="OnOpenClick">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type startup:FileCandidate}">
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Quit" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Open this one" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOpenClick" />
    </StackPanel>
  </StackPanel>
</Window>
