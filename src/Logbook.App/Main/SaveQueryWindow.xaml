<Window x:Class="Logbook.App.Main.SaveQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource WindowIcon}"
        Title="Save filter" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSaveClick" />
        <Button Content="Cancel" Style="{StaticResource FooterButton}" IsCancel="True" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Margin="{StaticResource PagePadding}">
      <TextBlock Style="{StaticResource TitleText}" Text="Save this filter" />
      <TextBlock x:Name="FilterLabel" Style="{StaticResource CaptionText}" FontFamily="{StaticResource MonoFont}" Margin="0,4,0,16" TextWrapping="Wrap" />
      <Label Content="Button name" />
      <TextBox x:Name="NameBox" />
      <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                 Text="Saving under a name that already exists replaces that button's filter. Right-click a button to remove it." />
      <TextBlock x:Name="Problem" Style="{StaticResource ProblemText}" Margin="0,8,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
