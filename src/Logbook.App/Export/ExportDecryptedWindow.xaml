<Window x:Class="Logbook.App.Export.ExportDecryptedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export decrypted" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="{StaticResource PagePadding}">
    <TextBlock Style="{StaticResource TitleText}" Text="Write a plaintext copy of the log" />
    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
               Text="The export is unencrypted and contains notes about people and situations; synced storage is searchable by people who are not you, so it defaults to a folder outside the synced root. Delete the file when you are done with it." />
    <Label Content="Save as" Margin="0,12,0,0" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="PathBox" />
      <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseClick" />
    </Grid>
    <CheckBox x:Name="IncludeHistory" Margin="0,12,0,0" Content="Include the full revision history (every line, tombstones included, in original order)" />
    <TextBlock x:Name="Status" Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button x:Name="ExportButton" Content="Export" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnExportClick" />
    </StackPanel>
  </StackPanel>
</Window>
