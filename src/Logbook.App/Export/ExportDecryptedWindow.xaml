<Window x:Class="Logbook.App.Export.ExportDecryptedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource WindowIcon}"
        Title="Export decrypted" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ExportButton" Content="Export" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnExportClick" />
        <Button Content="Cancel" Style="{StaticResource FooterButton}" IsCancel="True" Margin="8,0,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Margin="{StaticResource PagePadding}">
      <TextBlock Style="{StaticResource TitleText}" Text="Write a plaintext copy of the log" />
      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                 Text="The export is unencrypted and contains notes about people and situations. Logbook cannot tell which folders are synced, so it defaults to a private folder under your Windows profile, outside the log's folder; if you choose another folder, choose one that is not synced. Delete the file when you are done with it." />
      <Label Content="Save as" Margin="0,16,0,0" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" />
        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseClick" />
      </Grid>
      <CheckBox x:Name="IncludeHistory" Margin="0,16,0,0">
        <TextBlock TextWrapping="Wrap" Text="Include the full revision history (every line, tombstones included, in original order)" />
      </CheckBox>
      <TextBlock x:Name="Status" Margin="0,12,0,0" MinHeight="18" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
