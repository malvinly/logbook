<Window x:Class="Logbook.App.Export.ExportPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy as timeline" Width="780" Height="560" MinWidth="580" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Copied" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Copy to clipboard" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnCopyClick" />
          <Button Content="Close" Style="{StaticResource FooterButton}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="24,24,24,0">
      <TextBlock Style="{StaticResource TitleText}" Text="Copy as timeline" />
      <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="Oldest first, copied as plain text and as HTML for mail clients. Tags and people index for you, not for the reader, so they are left out unless you include them." />
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <CheckBox x:Name="ShowGaps" Content="Show gaps" Margin="0,0,24,0" Checked="OnToggle" Unchecked="OnToggle" />
        <CheckBox x:Name="GroupByMonth" Content="Group by month" Margin="0,0,24,0" Checked="OnToggle" Unchecked="OnToggle" />
        <CheckBox x:Name="Compact" Content="Compact" Margin="0,0,24,0" Checked="OnToggle" Unchecked="OnToggle" />
        <CheckBox x:Name="TagsAndPeople" Content="Tags and people" Checked="OnToggle" Unchecked="OnToggle" />
      </StackPanel>
    </StackPanel>
    <TextBox x:Name="Preview" Margin="24,12,24,24" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}"
             FontSize="{StaticResource CaptionSize}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
